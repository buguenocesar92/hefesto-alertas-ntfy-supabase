# Variables de entorno del kit Hefesto Alertas (ntfy 2.30.0 + Supabase).
# Este archivo es una PLANTILLA: no contiene ningun secreto real.
# Copielo a .env con permisos 600 y rellene los valores en el servidor.
#
# El detalle de cada variable (obligatoria, efecto si falta, donde se usa) esta
# en docs/CONTRATO.md.

# --- Conexion a la base de datos de Supabase (proyecto exclusivo) -----------
DB_HOST=db.REEMPLAZAR.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=ntfy_app
DB_PASSWORD=GENERAR_CON_OPENSSL_RAND_BASE64_32
# verify-full exige la CA en certs/ca.crt (ver docs/SECRETS.md).
# disable es el unico modo que funciona sin CA y solo para pruebas locales.
DB_SSLMODE=verify-full
PGSSLROOTCERT=/certs/ca.crt

# --- URL publica -----------------------------------------------------------
PUBLIC_URL=https://alertas.example.com

# --- Prefijo de los recursos del despliegue (proyecto Coolify) -------------
# El compose NO declara 'name:' en redes ni volumenes: el contrato P2 de
# scripts/coolify-check.sh lo prohibe para que Docker derive los nombres del
# nombre del proyecto. Este prefijo es el del proyecto en Coolify.
VOLUME_PREFIX=hefesto-alertas

# --- Confirmaciones obligatorias del preflight ------------------------------
SUPABASE_DEDICATED_CONFIRMED=false
SUPABASE_DATA_API_DISABLED=false

# --- Web Push (opcional; se genera una vez en el servidor) -----------------
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL_ADDRESS=

# --- Proxy inverso (opcional) ----------------------------------------------
NTFY_BEHIND_PROXY=false
NTFY_PROXY_TRUSTED_HOSTS=

# --- SMTP (opcional; este kit todavia no lo usa) ---------------------------
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
